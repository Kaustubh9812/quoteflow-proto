# Local AI settings. Do not put production secrets in this file.
# Use "ollama" to keep local development on your local Ollama service.
TASKTUCK_AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# For local OpenAI testing instead, use:
# TASKTUCK_AI_PROVIDER=openai
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_API_KEY=replace-with-your-local-key
