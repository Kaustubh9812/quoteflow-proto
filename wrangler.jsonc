{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "task-tuck",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "preview_urls": true
}
